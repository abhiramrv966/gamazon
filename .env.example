# Local demo is automatically enabled only by `next dev` without Supabase credentials.
# For a local production-build demo, explicitly set GAMAZON_DEMO=true.
# Never enable demo mode for a real community.
GAMAZON_DEMO=false
NEXT_PUBLIC_SUPABASE_URL=
# Public browser key: accepts sb_publishable_... or a legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only: sanitised image upload and scheduled deletion/retention worker.
# Accepts sb_secret_... or a legacy service_role key; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional scheduled outbox delivery endpoint bearer secret.
CRON_SECRET=
# Optional operator-only connection for migrations; never exposed to the browser.
SUPABASE_SESSION_POOLER=
